# Copy this file to .streamlit/secrets.toml and fill it in (that file is in .gitignore: never commit it).
# On Streamlit Community Cloud there is no file: paste the same lines into the app's "Secrets" box
# (Advanced settings when you deploy, or the app's settings afterwards).
# NOTHING here is required. Everything has a default; see the top of streamlit_app.py.
#
# Who pays for the questions?
#   - Leave ANTHROPIC_API_KEY out (the default for a public demo): every visitor is asked for their own Anthropic API key and their
#     questions are billed to it. You spend nothing, and there is no key of yours to protect. In this case you need no secrets file at all.
#   - Set it to pay for the visitors yourself. Then keep the limits below, and also set a spend limit in the Anthropic Console.

# ANTHROPIC_API_KEY = "sk-ant-..."

# Limits on YOUR key (they do not apply to a visitor who types their own key). The defaults are shown.
# APP_MAX_QUESTIONS = 20        # per browser session
# APP_DAILY_LIMIT = 200         # for the whole app per UTC day; 0 = no limit

# Optional: visitors must type this before they can ask anything. Use a long random phrase.
# APP_PASSCODE = "a-long-random-phrase"

# Optional: which search modes the sidebar offers. Leaving out hybrid_rerank means the reranker model is never loaded (less memory).
# APP_MODES = "vector,bm25,hybrid"

# Optional: Langfuse tracing (see tracing.py)
# LANGFUSE_PUBLIC_KEY = "pk-lf-..."
# LANGFUSE_SECRET_KEY = "sk-lf-..."
# LANGFUSE_BASE_URL = "https://cloud.langfuse.com"      # EU; use https://us.cloud.langfuse.com for the US region
